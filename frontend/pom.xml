<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.slixes</groupId>
        <artifactId>archlens</artifactId>
        <version>0.0.1-Alpha-06</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>archlens-frontend</artifactId>
    <packaging>pom</packaging>
    <name>Archlens — Clean Architecture Dynamic Workbench :: Frontend</name>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>install node and pnpm</id>
                        <goals>
                            <goal>install-node-and-pnpm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <pnpmVersion>${pnpm.version}</pnpmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pnpm install</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>install --frozen-lockfile=false</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pnpm check</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <phase>compile</phase>
                        <configuration>
                            <arguments>run check</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pnpm build</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <phase>compile</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pnpm test</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>run test:coverage</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
