{
  "name": "@fmatar/archlens",
  "version": "1.0.0",
  "description": "Cross-platform CLI and installer for Archlens Clean Architecture governance policies and AI assistant skills",
  "type": "module",
  "bin": {
    "archlens": "./cli/bin/index.js",
    "archlens-skill": "./cli/bin/index.js",
    "archlens-init": "./cli/bin/index.js"
  },
  "scripts": {
    "build": "mvn -B -ntp package -DskipTests",
    "start": "java -jar backend/target/quarkus-app/quarkus-run.jar",
    "smoke": "node scripts/smoke-test.js",
    "smoke:build": "node scripts/smoke-test.js --build",
    "test": "npm --prefix cli test && node --test scripts/test/*.test.js",
    "cli": "node ./cli/bin/index.js",
    "deps:check": "bash scripts/update-dependencies.sh --check",
    "deps:update": "bash scripts/update-dependencies.sh --safe",
    "deps:update:major": "bash scripts/update-dependencies.sh --safe --major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmatar/archlens.git"
  },
  "keywords": [
    "archlens",
    "clean-architecture",
    "architecture-governance",
    "claude-skill",
    "gemini-skill",
    "antigravity",
    "npx-installer"
  ],
  "author": "Fady Matar",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/fmatar/archlens/issues"
  },
  "homepage": "https://github.com/fmatar/archlens#readme"
}
