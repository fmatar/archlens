<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Ignore generated classes and synthetic lambdas -->
    <Match>
        <Class name="~.*_ClientProxy.*"/>
    </Match>
    <Match>
        <Class name="~.*_Subclass.*"/>
    </Match>

    <!-- Records and Models: EI_EXPOSE_REP and EI_EXPOSE_REP2 are normal for Java records and DTOs -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Project root analysis: The workbench intentionally reads source files from user-specified project roots -->
    <Match>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>

    <Match>
        <Bug pattern="INFORMATION_EXPOSURE_THROUGH_AN_ERROR_MESSAGE"/>
    </Match>

    <Match>
        <Package name="com.design.umlviewer.scanner"/>
        <Bug pattern="REDOS"/>
    </Match>
    <Match>
        <Package name="com.design.umlviewer.scanner"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    <Match>
        <Package name="com.design.umlviewer.scanner"/>
        <Bug pattern="MODIFICATION_AFTER_VALIDATION"/>
    </Match>
    <Match>
        <Package name="com.design.umlviewer.scanner"/>
        <Bug pattern="UC_USELESS_OBJECT"/>
    </Match>
    <Match>
        <Class name="com.design.umlviewer.scanner.GoAstScanner"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>
</FindBugsFilter>

