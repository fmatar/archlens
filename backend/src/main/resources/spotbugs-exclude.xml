<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Ignore generated classes and synthetic lambdas -->
    <Match>
        <Class name="~.*_ClientProxy.*"/>
    </Match>
    <Match>
        <Class name="~.*_Subclass.*"/>
    </Match>

    <!-- Records and Models: EI_EXPOSE_REP and EI_EXPOSE_REP2 are normal for Java records and DTOs -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Project root analysis: The workbench intentionally reads source files from user-specified project roots -->
    <Match>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>

    <Match>
        <Bug pattern="INFORMATION_EXPOSURE_THROUGH_AN_ERROR_MESSAGE"/>
    </Match>

    <Match>
        <Package name="io.slixes.archlens.scanner"/>
        <Bug pattern="REDOS"/>
    </Match>
    <Match>
        <Package name="io.slixes.archlens.scanner"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    <Match>
        <Package name="io.slixes.archlens.scanner"/>
        <Bug pattern="MODIFICATION_AFTER_VALIDATION"/>
    </Match>
    <Match>
        <Package name="io.slixes.archlens.scanner"/>
        <Bug pattern="UC_USELESS_OBJECT"/>
    </Match>
    <!-- FindSecBugs 1.14+ informational Jakarta REST endpoint inventory marker (not a defect) -->
    <Match>
        <Package name="io.slixes.archlens.delivery.rest"/>
        <Bug pattern="JAXRS_ENDPOINT"/>
    </Match>
    <Match>
        <Package name="io.slixes.archlens.delivery.rest"/>
        <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
    </Match>
    <Match>
        <Package name="io.slixes.archlens.delivery.rest"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    <Match>
        <Package name="io.slixes.archlens.domain.dossier"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    <!-- MermaidDiagramGenerator emits plain-text Mermaid syntax (e.g. <<interface>> stereotypes), not XML -->
    <Match>
        <Class name="io.slixes.archlens.domain.dossier.MermaidDiagramGenerator"/>
        <Bug pattern="POTENTIAL_XML_INJECTION"/>
    </Match>
    <Match>
        <Package name="io.slixes.archlens.usecase"/>
        <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
    </Match>
    <Match>
        <Package name="io.slixes.archlens.workspace.fs"/>
        <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
    </Match>
    <!-- LocalFilesystemGateway only invokes fixed macOS osascript folder picker arguments -->
    <Match>
        <Class name="io.slixes.archlens.workspace.fs.LocalFilesystemGateway"/>
        <Bug pattern="COMMAND_INJECTION"/>
    </Match>
    <!-- ProcessTestRunnerGateway only invokes fixed constant test runner arrays (mvn/gradle/cargo/pytest/go/npm) -->
    <Match>
        <Class name="io.slixes.archlens.verification.runner.ProcessTestRunnerGateway"/>
        <Bug pattern="COMMAND_INJECTION"/>
    </Match>
    <!-- ManageSnapshotsUseCase.runGitCommand invokes git directly (no shell) only after strict VALID_SNAPSHOT_ID regex validation -->
    <Match>
        <Class name="io.slixes.archlens.usecase.ManageSnapshotsUseCase"/>
        <Method name="runGitCommand"/>
        <Bug pattern="COMMAND_INJECTION"/>
    </Match>
</FindBugsFilter>

